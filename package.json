{
  "name": "anssipiirainen-blog",
  "version": "0.2.0",
  "description": "Personal blog of Anssi Piirainen",
  "private": true,
  "scripts": {
    "dev": "eleventy --serve --watch",
    "build": "eleventy",
    "build:ci": "run-s clean build",
    "clean": "rimraf public",
    "photos:push": "aws --profile anssipiirainen.com s3 sync ./src/images/photos/ s3://anssipiirainen.com/photos-src/ --delete --acl public-read",
    "photos:pull": "aws --profile anssipiirainen.com s3 sync s3://anssipiirainen.com/photos-src/ ./src/images/photos/"
  },
  "keywords": [
    "Website",
    "Blog",
    "11ty",
    "PWA"
  ],
  "author": "Anssi Piirainen",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^4.0.2",
    "@11ty/eleventy-plugin-rss": "^1.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "eleventy-plugin-reading-time": "^0.0.1",
    "html-minifier": "^4.0.0",
    "luxon": "^3.5.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5"
  }
}
