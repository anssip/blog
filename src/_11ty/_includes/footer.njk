<footer class="ftr">
  <div class="ftr-in">
    <div>
      <h4>contact</h4>
      <a href="mailto:{{ site.author.email }}">{{ site.author.email }}</a>
    </div>
    <div>
      <h4>content</h4>
      <a href="/">writing</a>
      <a href="/photos/">photos</a>
      <a href="/feed.xml">rss feed</a>
    </div>
    <div>
      <h4>networks</h4>
      {% for s in site.social %}
        <a href="{{ s.url }}">{{ s.label }}</a>
      {% endfor %}
    </div>
    <div>
      <h4>copyright</h4>
      <div class="line">© {{ site.copyrightStart }} — {% year %}</div>
      <div class="line">{{ site.author.name }}</div>
      <div class="line">{{ site.author.location }}</div>
    </div>
  </div>
</footer>
