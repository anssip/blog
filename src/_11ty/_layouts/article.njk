---
layout: base.njk
tags: post
type: article
---
<article class="prose article" data-screen-label="post">
  <header class="art-head">
    <div class="art-meta">
      {% if tag %}<span class="acc">{{ tag }}</span>{% endif %}
      <span>{{ page.date | readableDate }}</span>
      <span>{{ read or (content | readingTime) }}</span>
    </div>
    <h1 class="art-title">{{ title }}</h1>
    {% if subtitle %}<h2 class="art-sub">{{ subtitle }}</h2>{% endif %}
  </header>

  <div class="art-body">
    {{ content | safe }}
  </div>

  {% set previousPost = collections.visiblePosts | getPreviousCollectionItem(page) %}
  {% set nextPost     = collections.visiblePosts | getNextCollectionItem(page) %}

  <nav class="art-nav">
    {% if nextPost %}
      <a href="{{ nextPost.url }}">
        <span class="lbl">← older</span>
        <span class="ttl">{{ nextPost.data.title }}</span>
      </a>
    {% else %}<span></span>{% endif %}

    {% if previousPost %}
      <a class="right" href="{{ previousPost.url }}">
        <span class="lbl">newer →</span>
        <span class="ttl">{{ previousPost.data.title }}</span>
      </a>
    {% else %}<span></span>{% endif %}
  </nav>
</article>
